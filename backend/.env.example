# EduTicTac Robotics backend

# Ollama local por defecto. No uses endpoints remotos salvo autorizacion explicita.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:latest
EDUTICTAC_ALLOW_REMOTE_AI=false

# Entorno
EDUTICTAC_ENV=production
EDUTICTAC_LOG_LEVEL=INFO

# Identidad EduTicTac. En produccion, todas las credenciales son obligatorias.
APP_BASE_URL=https://robotics.edutictac.es
AUTHENTIK_ENABLED=true
AUTHENTIK_ISSUER_URL=https://auth.edutictac.es/application/o/edutictac-robotics/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SCOPES=openid profile email
SESSION_COOKIE_NAME=edutictac_robotics_session
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=691200
